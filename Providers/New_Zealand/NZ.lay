# LINZ aerial imagery basemap for New Zealand.
# Put a LINZ Basemaps API key (https://basemaps.linz.govt.nz/) after api_key=.
grid_type=webmercator
url_template=https://basemaps.linz.govt.nz/v1/tiles/aerial/WebMercatorQuad/{zoom}/{x}/{y}.jpeg?api={api_key}
api_key=
max_threads=8
imagery_dir=code
in_GUI=False
